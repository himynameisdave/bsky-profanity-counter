generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MentionStatus {
  UNPROCESSED
  ANALYZING
  DONE
  // We kept failing to process it and gave up, so it's never retried
  FAILED
}

model Mention {
  id            String        @id @default(cuid())
  userHandle    String        // The handle of the user to analyze
  postId        String        // The ID of the post containing the mention
  postUrl       String        // URL to the post
  isReply       Boolean       // Whether it's a reply or direct mention
  status        MentionStatus @default(UNPROCESSED)
  // How many times we've started processing it. Counted when it's claimed, so
  // an attempt cut short by a killed run still counts. Until it's DONE, every
  // one of these attempts failed or was cut short.
  attempts      Int           @default(0)
  // When we first started processing it. The retry window runs from here, so
  // time spent waiting in the queue doesn't count against it.
  firstAttemptedAt DateTime?
  replyPostId   String?       // The ID of our reply post (if we've replied)
  replyUrl      String?       // URL to our reply
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  // Relation to Analysis if needed
  analysisId    String?
  analysis      Analysis?     @relation(fields: [analysisId], references: [id])

  // One row per mentioning post, so replaying a notification can't create a
  // duplicate (and get the user two replies)
  @@unique([postId])
}

model Analysis {
  id                String    @id @default(cuid())
  userHandle        String    @unique  // The handle of the analyzed user
  totalPosts        Int       // Total posts analyzed
  profanityCount    Int       // Count of profanity instances
  profanityDetails  Json      // Store all profanity details including top ones
  lastAnalyzedAt    DateTime  @default(now())
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  // Relation to Mentions
  mentions          Mention[]
}
