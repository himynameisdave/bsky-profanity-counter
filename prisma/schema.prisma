// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MentionStatus {
  UNPROCESSED
  ANALYZING
  DONE
  // We kept failing to process it and gave up, so it's never retried
  FAILED
}

// A paused walk through one bot's unread notifications. Only advance this after
// every mention on the preceding page is safely stored. Keep the API timestamp
// verbatim so a read acknowledgement doesn't lose precision in a DateTime column.
model NotificationScan {
  botDid          String   @id
  cursor          String
  latestIndexedAt String?
  updatedAt       DateTime @updatedAt
}

model Mention {
  id            String        @id @default(cuid())
  did           String?       // Target identity; null only for quarantined legacy mentions
  userHandle    String        // Display only; never resolve this to choose a target
  postId        String        // The record key, scoped to its repository and collection
  postUrl       String        // The full AT URI of the mentioning post
  isReply       Boolean       // Whether it's a reply or direct mention
  status        MentionStatus @default(UNPROCESSED)
  // How many times we've started processing it. Counted when it's claimed, so
  // an attempt cut short by a killed run still counts. Until it's DONE, every
  // one of these attempts failed or was cut short.
  attempts      Int           @default(0)
  // When we first started processing it. The retry window runs from here, so
  // time spent waiting in the queue doesn't count against it.
  firstAttemptedAt DateTime?
  lastError     String?
  replyPostId   String?       // The ID of our reply post (if we've replied)
  replyUrl      String?       // URL to our reply
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  // Relation to Analysis if needed
  analysisId    String?
  analysis      Analysis?     @relation(fields: [analysisId], references: [id])

  // One row per mentioning post, so replaying a notification can't create a
  // duplicate (and get the user two replies)
  @@unique([postUrl])
  @@index([status, createdAt])
}

model Analysis {
  id                String    @id @default(cuid())
  did               String?   @unique // Null means archived/unproven; excluded from caches but may still count toward the profile total
  userHandle        String    // Display handle; also used to deduplicate archived profile totals, never as cache identity
  totalPosts        Int       // Total posts analyzed
  profanityCount    Int       // Count of profanity instances
  profanityDetails  Json      // Store all profanity details including top ones
  lastAnalyzedAt    DateTime  @default(now())
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  // Relation to Mentions
  mentions          Mention[]
}
